# Токен бота, полученный у @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID рабочего группового чата. ОБЯЗАТЕЛЕН: бот работает только в этой
# группе (все остальные чаты, включая личку с ботом, игнорируются).
# Чтобы узнать chat_id группы — добавьте бота в группу и посмотрите апдейты,
# либо временно используйте @userinfobot / @RawDataBot.
GROUP_CHAT_ID=-1001234567890

# Telegram user_id администраторов через запятую (они будут автоматически
# добавлены в whitelist с правами администратора при первом запуске бота)
ADMIN_IDS=111111111,222222222

# Строка подключения к БД. По умолчанию — SQLite, для перехода на Postgres:
# postgresql+asyncpg://user:password@host:5432/billiard
DATABASE_URL=sqlite+aiosqlite:///./data/billiard.db

# Папка для файловых логов
LOG_DIR=./data/logs
